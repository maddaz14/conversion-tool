{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "./",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "routes": [
    {
      "src": "/api/trigger-build",
      "dest": "/api/trigger-build.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/build-status",
      "dest": "/api/build-status.js",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

